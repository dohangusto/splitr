<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CKSharingSupported</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>splitr</string>
				<string>splitr-mock-share</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_splitr-join._tcp</string>
		<string>_splitr-join._udp</string>
		<string>_splitr-sync._tcp</string>
		<string>_splitr-sync._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Splitr uses your local network to discover nearby friends and sync bill split rooms in real time.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
